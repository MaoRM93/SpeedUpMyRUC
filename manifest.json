{
  "manifest_version": 3,
  "name": "SpeedUpMyRUC",
  "version": "101.0.0.100",
  "description": "拦截门户装饰性大图、精简页面冗余文案，各项可独立开关。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["*://*.ruc.edu.cn/*", "*://mapp.suda.edu.cn/*"],
  "permissions": ["declarativeNetRequest", "storage"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "banner", "enabled": true, "path": "rules/banner.json" },
      { "id": "background", "enabled": true, "path": "rules/background.json" },
      { "id": "footer", "enabled": true, "path": "rules/footer.json" },
      { "id": "captcha", "enabled": true, "path": "rules/captcha.json" }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://my.ruc.edu.cn/*", "*://cas.ruc.edu.cn/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://my.ruc.edu.cn/*"],
      "js": ["items.js", "ui-cleanup.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "SpeedUpMyRUC",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  }
}
